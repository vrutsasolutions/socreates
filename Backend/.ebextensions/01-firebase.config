# ──────────────────────────────────────────────────────────────────────
# Firebase service-account key — downloaded from S3 on every instance
# boot, stored outside EB's app directory so it survives app restarts.
#
# WHY /opt/ instead of /var/app/staging/:
#   EB's "Restart App Server" re-extracts the source bundle into
#   /var/app/current/, wiping anything container_commands placed
#   inside that tree (like /var/app/staging/secrets/). /opt/ is
#   never touched by EB's deploy/restart lifecycle, so the file
#   persists until the EC2 instance itself is terminated.
#
# WHY `commands` instead of `container_commands`:
#   `container_commands` only run during a DEPLOYMENT — not when EB
#   replaces an unhealthy instance, scales out, or does a platform
#   update. `commands` run on every instance launch, so a brand-new
#   instance always downloads the key before the app starts.
#
# REQUIRED EB ENV VAR (set once in the console, never changes):
#   FIREBASE_SERVICE_ACCOUNT_PATH = /opt/socreate/secrets/firebase-service-account.json
# ──────────────────────────────────────────────────────────────────────

commands:
  01_create_secrets_dir:
    command: "mkdir -p /opt/socreate/secrets"
  02_download_firebase_key:
    command: "aws s3 cp s3://socreate-frontend/backend-secrets/firebase-service-account.json /opt/socreate/secrets/firebase-service-account.json"
    ignoreErrors: false
  03_set_permissions:
    command: "chmod 444 /opt/socreate/secrets/firebase-service-account.json && chown webapp:webapp /opt/socreate/secrets/firebase-service-account.json"
