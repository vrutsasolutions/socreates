<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links: lets Android open www.socreate.in / socreate.in
                 links directly in this app instead of a browser, with no
                 chooser dialog — but ONLY once Android has verified we
                 actually control the domain via the assetlinks.json file
                 hosted at https://www.socreate.in/.well-known/assetlinks.json
                 (see that file for the required SHA-256 signing fingerprint).
                 android:autoVerify="true" is what triggers that verification
                 on install. If verification hasn't succeeded yet (file
                 missing/wrong fingerprint) or the app isn't installed at
                 all, Android falls through to opening the link in the
                 browser as normal — no extra code needed for that case. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.socreate.in" />
                <data android:scheme="https" android:host="socreate.in" />
            </intent-filter>

        </activity>

        <!-- FCM: default notification channel (must match MainActivity's CHANNEL_ID) -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="socreate_default" />

        <!-- FCM: small icon shown in the status bar + notification shade.
             Uses the app launcher icon until a dedicated monochrome
             ic_stat_socreate is designed. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />

        <!-- FCM: notification accent colour (SoCreate brand blue) -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/socreate_blue" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>


    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Voice messages: Chat.jsx calls navigator.mediaDevices.getUserMedia({audio:true}).
         Android can never grant a runtime permission that isn't declared here —
         without this line the WebView's mic prompt is silently denied every
         time, with no OS dialog ever shown to the user. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- ✅ ROOT-CAUSE FIX: Capacitor's built-in WebChromeClient.onPermissionRequest()
         (BridgeWebChromeClient.java) bundles BOTH RECORD_AUDIO and
         MODIFY_AUDIO_SETTINGS together whenever the WebView receives a getUserMedia
         audio-capture request, and only grants the mic to the page if EVERY
         permission in that bundle is granted. MODIFY_AUDIO_SETTINGS is a "normal"
         permission (no runtime dialog needed, auto-granted at install) — but ONLY
         if it's declared here. Without this line, Android silently reports it as
         not-granted, so the overall check fails and the WebView calls
         request.deny() on the mic — even though RECORD_AUDIO itself was already
         granted via the Microphone plugin above. This is why voice recording still
         failed on Android despite RECORD_AUDIO being present and permission
         requests succeeding: two different permission checks were involved, and
         only one of them was satisfied. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
</manifest>
